

<header class="relative">
  <div class="container mx-auto flex justify-between p-4">
    <!-- Logo image -->
    <a href="/">
      <img src="/sharequran_logo.png" alt="ShareQuran Logo" class="h-[200px]">
    </a>

    <!-- Burger button -->
    <button id="burgerBtn" class="cursor-pointer flex flex-col justify-between w-10 h-8">
      <span class="block w-full h-1 bg-[var(--color-primary)]"></span>
      <span class="block w-full h-1 bg-[var(--color-primary)]"></span>
      <span class="block w-full h-1 bg-[var(--color-primary)]"></span>
    </button>
  </div>

  <!-- Mobile menu -->
 <!-- Mobile menu -->
<nav
  id="mobileMenu"
  class="fixed inset-0 w-screen h-screen bg-[var(--color-primary)] text-[var(--color-neutral)]
         flex flex-col justify-center items-center space-y-6 p-8 hidden"
>
  <!-- Close button -->
  <button
    id="closeMenuBtn"
    class="absolute top-6 right-6 cursor-pointer text-4xl font-bold"
    aria-label="Close menu"
  >
    ×
  </button>

  <!-- Links -->
  <a href="/donate" class="text-2xl font-semibold">Donate</a>
  <a href="/about" class="text-2xl font-semibold">About</a>
  <a href="/statistics" class="text-2xl font-semibold">Statistics</a>

  <!-- Logo at bottom -->
  <a href="/" class="mt-8">
    <img src="/sharequran_logo.png" alt="ShareQuran Logo" class="h-[200px]">
  </a>
</nav>
  

 <script type="module">
    const burgerBtn = document.getElementById('burgerBtn');
    const closeMenuBtn = document.getElementById('closeMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');

    burgerBtn.addEventListener('click', () => {
      mobileMenu.classList.remove('hidden');
    });

    closeMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
    });
  </script>
</header>

